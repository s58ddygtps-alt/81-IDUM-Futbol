{
  "rules": {
    ".read": false,
    ".write": false,
    "admins": { "$uid": { ".read": "auth != null && auth.uid == $uid" } },
    "settings": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()"
    },
    "leaderboard": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()"
    },
    "players": {
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()",
      "$p": {
        ".read": "auth != null && auth.token.email == $p + '@81idum.uz'",
        "paid": { ".write": "auth != null && auth.token.email == $p + '@81idum.uz' && newData.val() == 'pending'" }
      }
    },
    "payments": {
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()",
      "$p": { ".read": "auth != null && auth.token.email == $p + '@81idum.uz'" }
    },
    "applications": {
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()",
      "$id": {
        ".write": "!data.exists() && newData.exists()",
        ".validate": "newData.hasChildren(['childName','phone','type'])"
      }
    }
  }
}
